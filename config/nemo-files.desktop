[Desktop Entry]
Type=Application
Name=Nemo Files
Name[pt_BR]=Nemo Arquivos
Name[ru]=Nemo Файлы
GenericName=File Manager
GenericName[pt_BR]=Gerenciador de arquivos
GenericName[ru]=Файловый менеджер
Comment=Pixel-art file manager of the Nemo shell
Comment[pt_BR]=Gerenciador de arquivos em pixel art do Nemo
Comment[ru]=Пиксельный файловый менеджер шелла Nemo
Exec=nemo-files %U
Icon=nemo-files
Terminal=false
MimeType=inode/directory;
Categories=System;FileTools;FileManager;Utility;
Keywords=folder;files;explorer;dolphin;
StartupWMClass=nemo-files
Actions=new-window;trash;

[Desktop Action new-window]
Name=New window
Name[pt_BR]=Nova janela
Name[ru]=Новое окно
Exec=nemo-files

[Desktop Action trash]
Name=Trash
Name[pt_BR]=Lixeira
Name[ru]=Корзина
Exec=nemo-files trash:///
